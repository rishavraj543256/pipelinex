FROM apache/airflow:2.10.5-python3.11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless && rm -rf /var/lib/apt/lists/*
USER airflow
COPY requirements-spark.txt /tmp/pipelinex-spark.txt
RUN pip install --no-cache-dir "apache-airflow==2.10.5" -r /tmp/pipelinex-spark.txt
COPY --chown=airflow:root pipelinex /opt/pipelinex/pipelinex
COPY --chown=airflow:root dags /opt/airflow/dags
ENV PYTHONPATH=/opt/pipelinex
