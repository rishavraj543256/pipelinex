FROM python:3.11-slim
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt && useradd --system --uid 10001 api
COPY alembic.ini .
COPY migrations migrations
COPY pipelinex pipelinex
USER api
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn pipelinex.api:app --host 0.0.0.0 --port ${PORT:-8000}"]
